# Exemplo sem credenciais. Copie as entradas necessárias para seu .env existente.
SECRET_KEY=substitua-por-uma-chave-secreta-local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/gbeachfood

ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Mesmo token configurado no webhook do painel Asaas (diferente da chave da API).
ASAAS_WEBHOOK_TOKEN=

# Gmail: use uma senha de app, gerada após ativar a verificação em duas etapas.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
# Se vazio, utiliza EMAIL_HOST_USER. Exemplo: GFood <sua-conta@gmail.com>
DEFAULT_FROM_EMAIL=

# Apenas para desenvolvimento sem envio real (DEBUG=True):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
